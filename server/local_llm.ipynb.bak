  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "header"
      },
      "source": [
        "# 🚀 Qwen2.5-7B-Instruct GGUF Model Deployment\n",
        "\n",
        "This notebook runs the Qwen2.5-7B-Instruct GGUF model and exposes it as a REST API.\n",
        "\n",
        "**Model**: Qwen2.5-7B-Instruct-Q4_K_M\n",
        "**Format**: GGUF (splitted: 00001-of-00002)\n",
        "\n",
        "---"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "install_deps"
      },
      "outputs": [],
      "source": [
        "# ===================================================\n",
        "# 1. INSTALL DEPENDENCIES\n",
        "# ===================================================\n",
        "\n",
        "# Install huggingface hub for downloading models\n",
        "!pip install huggingface-hub -q\n",
        "\n",
        "# Install llama-cpp-python with GPU support\n",
        "!CMAKE_ARGS=\"-DLLAMA_CUBLAS=on\" FORCE_CMAKE=1 pip install llama-cpp-python -q\n",
        "\n",
        "# Install other dependencies\n",
        "!pip install fastapi uvicorn nest-asyncio python-multipart -q\n",
        "!pip install pyngrok cloudflared -q\n",
        "\n",
        "print(\"✅ All dependencies installed!\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "huggingface_auth"
      },
      "outputs": [],
      "source": [
        "# ===================================================\n",
        "# 2. AUTHENTICATE WITH HUGGING FACE\n",
        "# ===================================================\n",
        "\n",
        "from huggingface_hub import login, HfApi, snapshot_download\n",
        "import os\n",
        "\n",
        "# Get your token from: https://huggingface.co/settings/tokens\n",
        "HF_TOKEN = \"your_huggingface_token_here\"  # ⚠️ REPLACE WITH YOUR TOKEN\n",
        "\n",
        "if HF_TOKEN == \"your_huggingface_token_here\":\n",
        "    print(\"⚠️ Please set your Hugging Face token above\")\n",
        "    print(\"Get your token from: https://huggingface.co/settings/tokens\")\n",
        "    # Option 1: Login interactively\n",
        "    login()\n",
        "else:\n",
        "    login(token=HF_TOKEN)\n",
        "    print(\"✅ Logged in to Hugging Face\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "download_model"
      },
      "outputs": [],
      "source": [
        "# ===================================================\n",
        "# 3. DOWNLOAD THE GGUF MODEL FROM HUGGING FACE\n",
        "# ===================================================\n",
        "\n",
        "from huggingface_hub import hf_hub_download\n",
        "import os\n",
        "\n",
        "# ⚠️ REPLACE WITH YOUR REPOSITORY\n",
        "REPO_ID = \"your-username/qwen2.5-7b-instruct-gguf\"\n",
        "\n",
        "# Model filename\n",
        "MODEL_FILE = \"qwen2.5-7b-instruct-q4_k_m.gguf\"\n",
        "\n",
        "# Alternative: Splitted files\n",
        "MODEL_FILES = [\n",
        "    \"qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf\",\n",
        "    \"qwen2.5-7b-instruct-q4_k_m-00002-of-00002.gguf\"\n",
        "]\n",
        "\n",
        "# Create models directory\n",
        "os.makedirs(\"/content/models\", exist_ok=True)\n",
        "\n",
        "print(f\"📁 Downloading model from: {REPO_ID}\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "model_path = None\n",
        "\n",
        "# Try downloading the main file first\n",
        "try:\n",
        "    model_path = hf_hub_download(\n",
        "        repo_id=REPO_ID,\n",
        "        filename=MODEL_FILE,\n",
        "        local_dir=\"/content/models\",\n",
        "        local_dir_use_symlinks=False\n",
        "    )\n",
        "    print(f\"✅ Downloaded: {MODEL_FILE}\")\n",
        "except Exception as e:\n",
        "    print(f\"⚠️ Could not download single file, trying splitted files...\")\n",
        "    \n",
        "    # Download splitted files\n",
        "    for filename in MODEL_FILES:\n",
        "        try:\n",
        "            path = hf_hub_download(\n",
        "                repo_id=REPO_ID,\n",
        "                filename=filename,\n",
        "                local_dir=\"/content/models\",\n",
        "                local_dir_use_symlinks=False\n",
        "            )\n",
        "            print(f\"✅ Downloaded: {filename}\")\n",
        "        except Exception as e2:\n",
        "            print(f\"❌ Error downloading {filename}: {e2}\")\n",
        "    \n",
        "    # Combine splitted files\n",
        "    print(\"\\n📦 Combining splitted GGUF files...\")\n",
        "    combined_path = \"/content/models/qwen2.5-7b-instruct-q4_k_m.gguf\"\n",
        "    \n",
        "    with open(combined_path, 'wb') as outfile:\n",
        "        for filename in MODEL_FILES:\n",
        "            part_path = f\"/content/models/{filename}\"\n",
        "            if os.path.exists(part_path):\n",
        "                with open(part_path, 'rb') as infile:\n",
        "                    outfile.write(infile.read())\n",
        "                print(f\"✅ Combined: {filename}\")\n",
        "    \n",
        "    model_path = combined_path\n",
        "    print(f\"✅ Combined model saved to: {model_path}\")\n",
        "\n",
        "if model_path and os.path.exists(model_path):\n",
        "    print(f\"\\n📊 Model ready at: {model_path}\")\n",
        "else:\n",
        "    print(\"\\n❌ Model download failed. Please check your repository and token.\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "load_model"
      },
      "outputs": [],
      "source": [
        "# ===================================================\n",
        "# 4. LOAD THE QWEN2.5 MODEL\n",
        "# ===================================================\n",
        "\n",
        "from llama_cpp import Llama\n",
        "import time\n",
        "import os\n",
        "\n",
        "# Find the model file\n",
        "model_dir = \"/content/models\"\n",
        "model_files = [f for f in os.listdir(model_dir) if f.endswith('.gguf')]\n",
        "\n",
        "if model_files:\n",
        "    model_path = os.path.join(model_dir, model_files[0])\n",
        "    print(f\"📁 Found model: {model_path}\")\n",
        "else:\n",
        "    print(\"❌ No GGUF model found in /content/models\")\n",
        "    print(\"Please download the model first.\")\n",
        "    raise FileNotFoundError(\"Model not found\")\n",
        "\n",
        "print(\"🔄 Loading Qwen2.5-7B-Instruct GGUF model...\")\n",
        "print(\"⏳ This may take 2-3 minutes...\")\n",
        "start_time = time.time()\n",
        "\n",
        "# Load the model\n",
        "llm = Llama(\n",
        "    model_path=model_path,\n",
        "    n_ctx=8192,\n",
        "    n_gpu_layers=35,\n",
        "    n_threads=8,\n",
        "    n_batch=512,\n",
        "    flash_attn=True,\n",
        "    verbose=False\n",
        ")\n",
        "\n",
        "load_time = time.time() - start_time\n",
        "print(f\"✅ Model loaded in {load_time:.2f} seconds!\")\n",
        "print(f\"📊 Model: {model_path}\")\n",
        "print(f\"📈 Context Length: 8192 tokens\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "test_model"
      },
      "outputs": [],
      "source": [
        "# ===================================================\n",
        "# 5. TEST THE QWEN2.5 MODEL\n",
        "# ===================================================\n",
        "\n",
        "def test_model(prompt):\n",
        "    \"\"\"Test the model with a prompt\"\"\"\n",
        "    output = llm.create_chat_completion(\n",
        "        messages=[\n",
        "            {\"role\": \"system\", \"content\": \"You are a helpful assistant. Answer accurately.\"},\n",
        "            {\"role\": \"user\", \"content\": prompt}\n",
        "        ],\n",
        "        max_tokens=200,\n",
        "        temperature=0.7,\n",
        "        top_p=0.95\n",
        "    )\n",
        "    return output[\"choices\"][0][\"message\"][\"content\"]\n",
        "\n",
        "print(\"🧪 Testing model...\")\n",
        "test_prompt = \"What is the capital of France?\"\n",
        "print(f\"📤 Prompt: {test_prompt}\")\n",
        "print(\"-\" * 40)\n",
        "response = test_model(test_prompt)\n",
        "print(f\"🤖 Response: {response}\")\n",
        "print(\"-\" * 40)\n",
        "print(\"✅ Model is working!\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "create_api"
      },
      "outputs": [],
      "source": [
        "# ===================================================\n",
        "# 6. CREATE FASTAPI SERVER\n",
        "# ===================================================\n",
        "\n",
        "%%writefile /content/server.py\n",
        "\n",
        "from fastapi import FastAPI, HTTPException\n",
        "from fastapi.middleware.cors import CORSMiddleware\n",
        "from pydantic import BaseModel\n",
        "from typing import Optional, List\n",
        "import uvicorn\n",
        "import json\n",
        "import sys\n",
        "import os\n",
        "\n",
        "app = FastAPI(title=\"Qwen2.5 GGUF Model API\")\n",
        "\n",
        "# Enable CORS\n",
        "app.add_middleware(\n",
        "    CORSMiddleware,\n",
        "    allow_origins=[\"*\"],\n",
        "    allow_credentials=True,\n",
        "    allow_methods=[\"*\"],\n",
        "    allow_headers=[\"*\"],\n",
        ")\n",
        "\n",
        "class GenerateRequest(BaseModel):\n",
        "    prompt: str\n",
        "    system_prompt: Optional[str] = None\n",
        "    temperature: float = 0.7\n",
        "    max_tokens: int = 1024\n",
        "    top_p: float = 0.95\n",
        "\n",
        "class ChatMessage(BaseModel):\n",
        "    role: str\n",
        "    content: str\n",
        "\n",
        "class ChatRequest(BaseModel):\n",
        "    messages: List[ChatMessage]\n",
        "    temperature: float = 0.7\n",
        "    max_tokens: int = 1024\n",
        "\n",
        "llm = None\n",
        "\n",
        "def set_model(model):\n",
        "    global llm\n",
        "    llm = model\n",
        "    return True\n",
        "\n",
        "@app.get(\"/\")\n",
        "async def root():\n",
        "    return {\n",
        "        \"message\": \"Qwen2.5 GGUF Model API is running!\",\n",
        "        \"model\": \"Qwen2.5-7B-Instruct-Q4_K_M\",\n",
        "        \"status\": \"healthy\"\n",
        "    }\n",
        "\n",
        "@app.get(\"/health\")\n",
        "async def health():\n",
        "    return {\"status\": \"healthy\", \"model_loaded\": llm is not None}\n",
        "\n",
        "@app.post(\"/generate\")\n",
        "async def generate(request: GenerateRequest):\n",
        "    if llm is None:\n",
        "        raise HTTPException(status_code=503, detail=\"Model not loaded\")\n",
        "    try:\n",
        "        messages = []\n",
        "        if request.system_prompt:\n",
        "            messages.append({\"role\": \"system\", \"content\": request.system_prompt})\n",
        "        messages.append({\"role\": \"user\", \"content\": request.prompt})\n",
        "        \n",
        "        output = llm.create_chat_completion(\n",
        "            messages=messages,\n",
        "            max_tokens=request.max_tokens,\n",
        "            temperature=request.temperature,\n",
        "            top_p=request.top_p\n",
        "        )\n",
        "        \n",
        "        return {\n",
        "            \"response\": output[\"choices\"][0][\"message\"][\"content\"],\n",
        "            \"usage\": output.get(\"usage\", {})\n",
        "        }\n",
        "    except Exception as e:\n",
        "        raise HTTPException(status_code=500, detail=str(e))\n",
        "\n",
        "@app.post(\"/chat\")\n",
        "async def chat(request: ChatRequest):\n",
        "    if llm is None:\n",
        "        raise HTTPException(status_code=503, detail=\"Model not loaded\")\n",
        "    try:\n",
        "        messages = [{\"role\": msg.role, \"content\": msg.content} for msg in request.messages]\n",
        "        \n",
        "        output = llm.create_chat_completion(\n",
        "            messages=messages,\n",
        "            max_tokens=request.max_tokens,\n",
        "            temperature=request.temperature\n",
        "        )\n",
        "        \n",
        "        return {\n",
        "            \"response\": output[\"choices\"][0][\"message\"][\"content\"],\n",
        "            \"usage\": output.get(\"usage\", {})\n",
        "        }\n",
        "    except Exception as e:\n",
        "        raise HTTPException(status_code=500, detail=str(e))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "start_server_and_tunnel"
      },
      "outputs": [],
      "source": [
        "# ===================================================\n",
        "# 7. START SERVER + CLOUDFLARE TUNNEL (COMBINED)\n",
        "# ===================================================\n",
        "\n",
        "import subprocess\n",
        "import threading\n",
        "import time\n",
        "import sys\n",
        "import asyncio\n",
        "import nest_asyncio\n",
        "\n",
        "nest_asyncio.apply()\n",
        "\n",
        "print(\"🚀 Starting Qwen2.5 API Server + Cloudflare Tunnel\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# Step 1: Start the API server in background\n",
        "import server\n",
        "server.set_model(llm)\n",
        "\n",
        "def run_server():\n",
        "    import uvicorn\n",
        "    uvicorn.run(server.app, host=\"0.0.0.0\", port=8000, log_level=\"warning\")\n",
        "\n",
        "server_thread = threading.Thread(target=run_server, daemon=True)\n",
        "server_thread.start()\n",
        "\n",
        "# Wait for server to start\n",
        "time.sleep(5)\n",
        "print(\"✅ API Server running on port 8000\")\n",
        "\n",
        "# Step 2: Start Cloudflare Tunnel in background\n",
        "print(\"🌐 Starting Cloudflare Tunnel...\")\n",
        "print(\"\")\n",
        "print(\"🔗 YOUR PUBLIC URL WILL APPEAR BELOW\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# Run cloudflared in a subprocess\n",
        "process = subprocess.Popen(\n",
        "    ['cloudflared', 'tunnel', '--url', 'http://localhost:8000'],\n",
        "    stdout=subprocess.PIPE,\n",
        "    stderr=subprocess.STDOUT,\n",
        "    universal_newlines=True,\n",
        "    bufsize=1\n",
        ")\n",
        "\n",
        "# Capture and display the output\n",
        "public_url = None\n",
        "for line in process.stdout:\n",
        "    print(line.strip())\n",
        "    if 'trycloudflare.com' in line:\n",
        "        # Extract the URL\n",
        "        import re\n",
        "        match = re.search(r'https://[a-zA-Z0-9-]+\\.trycloudflare\\.com', line)\n",
        "        if match:\n",
        "            public_url = match.group(0)\n",
        "            print(\"\")\n",
        "            print(\"=\" * 60)\n",
        "            print(\"✅ PUBLIC URL FOUND!\")\n",
        "            print(\"=\" * 60)\n",
        "            print(f\"🔗 {public_url}\")\n",
        "            print(\"=\" * 60)\n",
        "            print(\"\")\n",
        "            print(\"📌 API ENDPOINTS:\")\n",
        "            print(f\"   - Health:  {public_url}/health\")\n",
        "            print(f\"   - Generate: {public_url}/generate\")\n",
        "            print(f\"   - Chat:    {public_url}/chat\")\n",
        "            print(\"\")\n",
        "            print(\"💡 SAVE THIS URL for your backend .env file:\")\n",
        "            print(f\"   LOCAL_MODEL_URL={public_url}\")\n",
        "            print(\"\")\n",
        "            print(\"⚠️  Keep this cell running to maintain the tunnel\")\n",
        "            print(\"=\" * 60)\n",
        "\n",
        "# Keep the script running\n",
        "try:\n",
        "    while True:\n",
        "        time.sleep(1)\n",
        "except KeyboardInterrupt:\n",
        "    process.terminate()\n",
        "    print(\"\\n🛑 Server stopped\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "test_api"
      },
      "outputs": [],
      "source": [
        "# ===================================================\n",
        "# 8. TEST THE API (Run after getting the URL)\n",
        "# ===================================================\n",
        "\n",
        "import requests\n",
        "\n",
        "# ⚠️ REPLACE WITH YOUR ACTUAL URL from above\n",
        "PUBLIC_URL = \"https://your-url.trycloudflare.com\"\n",
        "\n",
        "def test_api():\n",
        "    url = f\"{PUBLIC_URL}/generate\"\n",
        "    payload = {\n",
        "        \"prompt\": \"Explain artificial intelligence in simple terms\",\n",
        "        \"system_prompt\": \"You are a helpful assistant. Keep answers concise.\",\n",
        "        \"temperature\": 0.7,\n",
        "        \"max_tokens\": 300\n",
        "    }\n",
        "    \n",
        "    print(\"🧪 Testing API...\")\n",
        "    print(f\"📤 Sending: {payload['prompt']}\")\n",
        "    print(\"-\" * 40)\n",
        "    \n",
        "    response = requests.post(url, json=payload)\n",
        "    \n",
        "    if response.status_code == 200:\n",
        "        data = response.json()\n",
        "        print(f\"🤖 Response: {data['response']}\")\n",
        "        print(f\"📊 Usage: {data.get('usage', {})}\")\n",
        "    else:\n",
        "        print(f\"❌ Error: {response.text}\")\n",
        "\n",
        "if PUBLIC_URL and PUBLIC_URL != \"https://your-url.trycloudflare.com\":\n",
        "    test_api()\n",
        "else:\n",
        "    print(\"⚠️ Please set PUBLIC_URL with your Cloudflare URL from above\")"
      ]
    }
  ],
